# Dev-time tool installs (npx impeccable install) and local test dependencies.
# Playwright lives in masswerk/tests/node_modules; the other tests/node_modules
# are local junctions or symlinks to it (see CLAUDE.md).
.claude/
.agents/
.codex/
.cursor/
node_modules/

# Official Lehrplan text stays local: the PDF, the extracted Stufen and the
# Markdown working copy produced by tools/lehrplan-extraktion are never committed.
tools/lehrplan-extraktion/*.pdf
tools/lehrplan-extraktion/stufen.json
tools/lehrplan-extraktion/markdown/

# Impeccable critique snapshots are local tool state; the shared config is committed.
.impeccable/critique/
.impeccable/config.local.json
.impeccable/live/
